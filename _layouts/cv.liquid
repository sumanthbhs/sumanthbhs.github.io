---
layout: default
---
{% comment %}
  Local override of the al_folio_core `cv` layout.

  The entries under JSON Resume's `projects` key are student project supervision, not the
  author's own projects, and al_folio_cv hardcodes that section's heading as "Projects".
  JSON Resume has no supervision section, so rather than vendor the plugin's whole render
  template to change one word, capture its output and retitle just that section. Keep the
  rest of the layout identical to the gem's so upgrades stay easy to diff.
{% endcomment %}
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% capture cv_html %}{% al_folio_cv_render %}{% endcapture %}
  {% assign cv_html = cv_html | replace: '<a class="anchor" id="projects"></a>', '<a class="anchor" id="supervision"></a>' %}
  {% assign cv_html = cv_html | replace: '>Projects</h3>', '>Supervision</h3>' %}
  {{ cv_html }}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
